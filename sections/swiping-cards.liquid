{% comment %}
  Tinder-Style Floating Swipe Cards Section
{% endcomment %}

{% liquid
  if template.name == 'product' and product.collections.first
    assign products_list = product.collections.first.products
  elsif template.name == 'collection'
    assign products_list = collection.products
  else
    assign products_list = collections.all.products
  endif
%}

<!-- Floating Trigger Button (Bottom Right) -->
<button type="button" id="OpenSwipeDeckBtn" class="swipe-fab-btn" aria-label="Open Swipe Deck">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
    <line x1="12" y1="22.08" x2="12" y2="12"></line>
  </svg>
  <span>Discover</span>
</button>

<!-- Swipe Overlay Modal -->
<div id="SwipeModal" class="swipe-modal" aria-hidden="true">
  <div class="swipe-modal-backdrop" id="SwipeModalBackdrop"></div>

  <div class="swipe-container-wrapper">
    <!-- Close Button -->
    <button type="button" id="CloseSwipeDeckBtn" class="swipe-close-btn" aria-label="Close">
      &times;
    </button>

    <div class="swipe-cards-deck" id="SwipeCardsDeck">
      {% for prod in products_list limit: 20 %}
        {% assign variant = prod.first_available_variant %}
        {% if variant %}
          {% assign images_count = prod.images.size %}
          <div class="swipe-card" 
               data-variant-id="{{ variant.id }}" 
               data-dots-position="{{ section.settings.dots_position | default: 'outside' }}"
               style="z-index: {{ forloop.rindex }};">
            <div class="card-frame">
              <div class="card-images-container">
                {% if images_count > 0 %}
                  {% for image in prod.images limit: 5 %}
                    <img src="{{ image | image_url: width: 800 }}" 
                         alt="{{ prod.title }}" 
                         class="card-image {% if forloop.first %}is-active{% endif %}" 
                         data-image-index="{{ forloop.index0 }}"
                         loading="lazy">
                  {% endfor %}
                {% else %}
                  <img src="{{ prod.featured_image | image_url: width: 800 }}" 
                       alt="{{ prod.title }}" 
                       class="card-image is-active" 
                       data-image-index="0"
                       loading="lazy">
                {% endif %}
              </div>
              <div class="card-overlay">
                <span class="card-title">{{ prod.title }}</span>
                <span class="card-divider">|</span>
                <span class="card-price">{{ prod.price | money }}</span>
              </div>
              <div class="swipe-badge swipe-badge-like">ADDED</div>
              <div class="swipe-badge swipe-badge-pass">PASS</div>
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="no-products-msg">No products left to swipe!</div>
      {% endfor %}
    </div>

    <div class="swipe-instruction-btn">Swipe Right to Add • Left to Pass</div>
  </div>
</div>

<style>
/* Floating Bottom-Right Action Button */
.swipe-fab-btn {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 9998;
  display: flex;
  align-items: center;
  gap: 8px;
  background: #2b170c;
  color: #e0b07a;
  border: 1px solid #CBA158;
  padding: 12px 20px;
  border-radius: 50px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.swipe-fab-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
}

/* Modal Overlay */
.swipe-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  background-image: url('{{ "collection-background.jpg" | asset_url }}') !important;
  background-size: cover !important;
  background-position: top center !important;
  background-repeat: no-repeat !important;
}

.swipe-modal.is-active {
  opacity: 1;
  pointer-events: auto;
}

.swipe-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(5px);
}

/* Modal Content Container */
.swipe-container-wrapper {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 90%;
  max-width: 420px;
  user-select: none;
  -webkit-user-select: none;
}

/* Close Button */
.swipe-close-btn {
  position: absolute;
  top: -45px;
  right: 0;
  background: transparent;
  border: none;
  color: #fff;
  font-size: 2rem;
  line-height: 1;
  cursor: pointer;
  opacity: 0.8;
  transition: opacity 0.2s;
}

.swipe-close-btn:hover {
  opacity: 1;
}

.swipe-cards-deck {
  position: relative;
  width: 100%;
  height: 540px;
}

.swipe-card {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 12px;
  cursor: grab;
  touch-action: none;
  transition: transform 0.2s ease-out;
  will-change: transform;
}

.swipe-card:active {
  cursor: grabbing;
}

.card-frame {
  position: relative;
  width: 100%;
  border-radius: 8px;
  border: 8px solid #CBA158;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  overflow: hidden;
  background: #000;
}

.swipe-card[data-dots-position="outside"] .card-frame {
  height: calc(100% - 65px);
}

.swipe-card[data-dots-position="inside"] .card-frame,
.swipe-card:not([data-dots-position]) .card-frame {
  height: 100%;
}

.card-images-container {
  position: relative;
  width: 100%;
  height: 100%;
}

.card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.card-image.is-active {
  opacity: 1;
  z-index: 1;
}

.card-overlay {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 10px 24px;
  border-radius: 30px;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  white-space: nowrap;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.15);
  z-index: 5;
}

.card-title {
  font-family: Georgia, Didot, "Playfair Display", serif;
  font-size: 1.15rem;
  font-weight: 400;
  letter-spacing: 0.03em;
  color: #ffffff;
}

.card-divider {
  font-family: Georgia, Didot, "Playfair Display", serif;
  font-size: 1.15rem;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
}

.card-price {
  font-family: Georgia, Didot, "Playfair Display", serif;
  font-size: 1.15rem;
  font-weight: 400;
  letter-spacing: 0.03em;
  color: #ffffff;
}

.card-nav-dots--outside {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 65px;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
  pointer-events: none;
}

.card-nav-dots--inside {
  position: absolute;
  bottom: 15px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
  pointer-events: none;
}

.nav-dots-container {
  display: inline-flex;
  align-items: center;
  background: rgba(80, 70, 60, 0.75);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 6px 12px;
  border-radius: 20px;
  gap: 8px;
  height: 24px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

.nav-dot {
  display: block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.6);
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              background-color 0.3s ease, 
              border-radius 0.3s ease;
}

.nav-dot.is-active {
  width: 28px;
  border-radius: 4px;
  background-color: #542d13;
}

.swipe-badge {
  position: absolute;
  top: 25px;
  padding: 6px 14px;
  border-radius: 8px;
  font-weight: bold;
  font-size: 1.3rem;
  opacity: 0;
  transition: opacity 0.1s ease;
  z-index: 5;
}

.swipe-badge-like {
  left: 25px;
  border: 3px solid #2ecc71;
  color: #2ecc71;
  transform: rotate(-15deg);
}

.swipe-badge-pass {
  right: 25px;
  border: 3px solid #e74c3c;
  color: #e74c3c;
  transform: rotate(15deg);
}

.swipe-instruction-btn {
  margin-top: 30px;
  width: 100%;
  background: #2b170c;
  color: #e0b07a;
  border: 1px solid #CBA158;
  text-align: center;
  padding: 14px;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 500;
}

.no-products-msg {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #fff;
  font-size: 1.2rem;
  text-align: center;
}
</style>

{% comment %} <script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('SwipeModal');
  const openBtn = document.getElementById('OpenSwipeDeckBtn');
  const closeBtn = document.getElementById('CloseSwipeDeckBtn');
  const backdrop = document.getElementById('SwipeModalBackdrop');
  const deck = document.getElementById('SwipeCardsDeck');
  const cards = deck.querySelectorAll('.swipe-card');

  // Toggle Modal Logic
  const openModal = () => {
    modal.classList.add('is-active');
    modal.setAttribute('aria-hidden', 'false');
  };

  const closeModal = () => {
    modal.classList.remove('is-active');
    modal.setAttribute('aria-hidden', 'true');
  };

  openBtn.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);

  // Swipe Engine
  cards.forEach(card => initSwipe(card));

  function initSwipe(card) {
    let startX = 0;
    let startY = 0;
    let currentX = 0;
    let currentY = 0;
    let isDragging = false;

    const likeBadge = card.querySelector('.swipe-badge-like');
    const passBadge = card.querySelector('.swipe-badge-pass');

    const onStart = (e) => {
      isDragging = true;
      startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      startY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;
      card.style.transition = 'none';
    };

    const onMove = (e) => {
      if (!isDragging) return;

      const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;

      currentX = clientX - startX;
      currentY = clientY - startY;

      const rotate = currentX * 0.08;
      card.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) rotate(${rotate}deg)`;

      if (currentX > 40) {
        likeBadge.style.opacity = Math.min(currentX / 100, 1);
        passBadge.style.opacity = 0;
      } else if (currentX < -40) {
        passBadge.style.opacity = Math.min(Math.abs(currentX) / 100, 1);
        likeBadge.style.opacity = 0;
      } else {
        likeBadge.style.opacity = 0;
        passBadge.style.opacity = 0;
      }
    };

    const onEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      card.style.transition = 'transform 0.4s ease, opacity 0.4s ease';

      const threshold = 100;

      if (currentX > threshold) {
        card.style.transform = `translate3d(${window.innerWidth}px, ${currentY}px, 0) rotate(45deg)`;
        card.style.opacity = '0';
        addToCart(card.dataset.variantId);
        setTimeout(() => card.remove(), 400);
      } else if (currentX < -threshold) {
        card.style.transform = `translate3d(-${window.innerWidth}px, ${currentY}px, 0) rotate(-45deg)`;
        card.style.opacity = '0';
        setTimeout(() => card.remove(), 400);
      } else {
        card.style.transform = 'translate3d(0, 0, 0) rotate(0deg)';
        likeBadge.style.opacity = 0;
        passBadge.style.opacity = 0;
      }
    };

    card.addEventListener('touchstart', onStart, { passive: true });
    card.addEventListener('touchmove', onMove, { passive: true });
    card.addEventListener('touchend', onEnd);

    card.addEventListener('mousedown', onStart);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onEnd);
  }

  // Ajax Add to Cart
  function addToCart(variantId) {
    const formData = {
      items: [{
        id: parseInt(variantId, 10),
        quantity: 1
      }]
    };

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(() => {
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      document.dispatchEvent(new CustomEvent('cart:updated'));
    })
    .catch((error) => console.error('Error adding to cart:', error));
  }
});
</script> {% endcomment %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('SwipeModal');
  const openBtn = document.getElementById('OpenSwipeDeckBtn');
  const closeBtn = document.getElementById('CloseSwipeDeckBtn');
  const backdrop = document.getElementById('SwipeModalBackdrop');
  const deck = document.getElementById('SwipeCardsDeck');
  const cards = deck ? deck.querySelectorAll('.swipe-card') : [];

  // Toggle Modal Logic
  const openModal = () => {
    modal.classList.add('is-active');
    modal.setAttribute('aria-hidden', 'false');
  };

  const closeModal = () => {
    modal.classList.remove('is-active');
    modal.setAttribute('aria-hidden', 'true');
  };

  if (openBtn) openBtn.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (backdrop) backdrop.addEventListener('click', closeModal);

  // Swipe Engine
  cards.forEach(card => initSwipe(card));

  function initSwipe(card) {
    let startX = 0;
    let startY = 0;
    let currentX = 0;
    let currentY = 0;
    let isDragging = false;
    let startTime = 0;

    const likeBadge = card.querySelector('.swipe-badge-like');
    const passBadge = card.querySelector('.swipe-badge-pass');

    const handleCardTap = (clientX) => {
      const cardRect = card.getBoundingClientRect();
      const tapX = clientX - cardRect.left;
      const isLeft = tapX < cardRect.width / 2;

      const images = card.querySelectorAll('.card-image');
      if (images.length <= 1) return;

      let activeIndex = 0;
      images.forEach((img, index) => {
        if (img.classList.contains('is-active')) {
          activeIndex = index;
        }
      });

      let newIndex = activeIndex;
      if (isLeft) {
        newIndex = (activeIndex - 1 + images.length) % images.length;
      } else {
        newIndex = (activeIndex + 1) % images.length;
      }

      images[activeIndex].classList.remove('is-active');
      images[newIndex].classList.add('is-active');

      const dots = card.querySelectorAll('.nav-dot');
      if (dots.length > 0) {
        dots.forEach((dot, index) => {
          if (index === newIndex) {
            dot.classList.add('is-active');
          } else {
            dot.classList.remove('is-active');
          }
        });
      }
    };

    const onStart = (e) => {
      isDragging = true;
      const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;
      startX = clientX;
      startY = clientY;
      currentX = 0;
      currentY = 0;
      startTime = Date.now();
      card.style.transition = 'none';
    };

    const onMove = (e) => {
      if (!isDragging) return;

      const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;

      currentX = clientX - startX;
      currentY = clientY - startY;

      const rotate = currentX * 0.08;
      card.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) rotate(${rotate}deg)`;

      if (currentX > 40) {
        likeBadge.style.opacity = Math.min(currentX / 100, 1);
        passBadge.style.opacity = 0;
      } else if (currentX < -40) {
        passBadge.style.opacity = Math.min(Math.abs(currentX) / 100, 1);
        likeBadge.style.opacity = 0;
      } else {
        likeBadge.style.opacity = 0;
        passBadge.style.opacity = 0;
      }
    };

    const onEnd = (e) => {
      if (!isDragging) return;
      isDragging = false;
      card.style.transition = 'transform 0.4s ease, opacity 0.4s ease';

      const endTime = Date.now();
      const duration = endTime - startTime;
      const moveThreshold = 10;
      const clickDuration = 250;

      const absX = Math.abs(currentX);
      const absY = Math.abs(currentY);

      if (absX < moveThreshold && absY < moveThreshold && duration < clickDuration) {
        handleCardTap(startX);
        return;
      }

      const threshold = 100;

      if (currentX > threshold) {
        // SWIPE RIGHT: Add to Cart
        card.style.transform = `translate3d(${window.innerWidth}px, ${currentY}px, 0) rotate(45deg)`;
        card.style.opacity = '0';
        addToCart(card.dataset.variantId);
        setTimeout(() => card.remove(), 400);
      } else if (currentX < -threshold) {
        // SWIPE LEFT: Pass / Remove
        card.style.transform = `translate3d(-${window.innerWidth}px, ${currentY}px, 0) rotate(-45deg)`;
        card.style.opacity = '0';
        setTimeout(() => card.remove(), 400);
      } else {
        card.style.transform = 'translate3d(0, 0, 0) rotate(0deg)';
        likeBadge.style.opacity = 0;
        passBadge.style.opacity = 0;
      }
    };

    card.addEventListener('touchstart', onStart, { passive: true });
    card.addEventListener('touchmove', onMove, { passive: true });
    card.addEventListener('touchend', onEnd);

    card.addEventListener('mousedown', onStart);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onEnd);
  }

  // Universal Shopify AJAX Add to Cart
  function addToCart(variantId) {
    const cartDrawer = document.querySelector('cart-drawer');
    const cartNotification = document.querySelector('cart-notification');

    // Build array of section IDs to request from Shopify API
    const sectionsToFetch = [];
    if (cartDrawer) sectionsToFetch.push('cart-drawer', 'cart-icon-bubble');
    if (cartNotification) sectionsToFetch.push('cart-notification', 'cart-icon-bubble');

    const formData = {
      items: [{
        id: parseInt(variantId, 10),
        quantity: 1
      }],
      sections: sectionsToFetch // FIXED: Must be an Array
    };

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/javascript'
      },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      // 1. Dawn & OS 2.0 Web Components (Drawer / Notification)
      if (cartDrawer && data.sections && data.sections['cart-drawer']) {
        cartDrawer.renderContents(data);
      } else if (cartNotification && data.sections && data.sections['cart-notification']) {
        cartNotification.renderContents(data);
      } else if (cartDrawer) {
        // Fallback: Fetch cart-drawer HTML directly if section parsing was skipped
        fetch(window.Shopify.routes.root + '?section_id=cart-drawer')
          .then(res => res.text())
          .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newContent = doc.querySelector('.drawer__inner') || doc.querySelector('#CartDrawer');
            const currentContent = cartDrawer.querySelector('.drawer__inner') || cartDrawer.querySelector('#CartDrawer');
            if (newContent && currentContent) {
              currentContent.innerHTML = newContent.innerHTML;
            }
          });
      }

      // 2. Trigger Shopify PubSub Event (Dawn Standard)
      if (typeof publish === 'function' && window.PUB_SUB_EVENTS) {
        publish(PUB_SUB_EVENTS.cartUpdate, { source: 'swipe-card', cart: data });
      }

      // 3. Custom Theme Dispatchers
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: data } }));
      document.dispatchEvent(new CustomEvent('cart:build', { detail: data }));
      document.dispatchEvent(new CustomEvent('theme:cart:change', { detail: { cart: data } }));

      // 4. Open Cart Drawer
      if (cartDrawer && typeof cartDrawer.open === 'function') {
        cartDrawer.open();
      } else {
        const cartIconBtn = document.querySelector('#cart-icon-bubble, .header__icon--cart, [data-cart-drawer-toggle], .js-drawer-open-right');
        if (cartIconBtn && !cartDrawer?.classList.contains('active')) {
          cartIconBtn.click();
        }
      }
    })
    .catch((error) => console.error('Error adding product to cart:', error));
  }
});
</script>

{% schema %}
{
  "name": "Swipe Cards Modal",
  "settings": [
    {
      "type": "select",
      "id": "dots_position",
      "options": [
        {
          "value": "outside",
          "label": "Outside the card frame"
        },
        {
          "value": "inside",
          "label": "Inside the card frame"
        }
      ],
      "default": "outside",
      "label": "Navigation dots position"
    }
  ],
  "presets": [
    {
      "name": "Swipe Cards Modal"
    }
  ]
}
{% endschema %}
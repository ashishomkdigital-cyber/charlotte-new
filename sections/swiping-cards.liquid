{% comment %}
  Tinder-Style Floating Swipe Cards Section
{% endcomment %}

{% liquid
  if template.name == 'product' and product.collections.first
    assign products_list = product.collections.first.products
  elsif template.name == 'collection'
    assign products_list = collection.products
  else
    assign products_list = collections.all.products
  endif
%}

<style>
  .card-info-area{
      margin-top: -7rem;
      margin-left: 10px;
      margin-right: 10px;
      border-radius: 10px;
  }
</style>



<!-- Swipe Overlay Modal -->
<div id="SwipeModal" class="swipe-modal" aria-hidden="true">
  <div class="swipe-modal-backdrop" id="SwipeModalBackdrop"></div>

  <!-- Modal Header -->
  <div class="swipe-modal-header">
    <button type="button" id="CloseSwipeDeckBtn" class="swipe-modal-back-btn" aria-label="Back">
      &lsaquo; Back
    </button>
    <div class="swipe-logo-and-toggle">
      <div class="swipe-modal-logo">
        CHARLOTTE
      </div>
      <div class="collection-header-toggle" style="display: flex;gap: 5px;align-items: center;">
        <label class="theme-toggle-switch">
          <input type="checkbox" class="layout-toggle-checkbox">
          <span class="theme-toggle-slider"></span>
        </label>
        <span style="
    color: #fff;
    font-size: 8px;
    line-height: 1;
">
              Open Interactive Layout
          </span>
      </div>
    </div>
    <div class="swipe-modal-header-placeholder"></div>
  </div>

  <div class="swipe-container-wrapper">

    <div class="swipe-cards-deck" id="SwipeCardsDeck">
      {% for prod in products_list limit: 20 %}
        {% assign variant = prod.first_available_variant %}
        {% if variant %}
          {% assign images_count = prod.images.size %}
          <div class="swipe-card" 
               data-variant-id="{{ variant.id }}" 
               data-dots-position="{{ section.settings.dots_position | default: 'outside' }}"
               style="z-index: {{ forloop.rindex }};">
            <div class="card-frame">
              <div class="card-images-container">
                {% if images_count > 0 %}
                  {% for image in prod.images limit: 5 %}
                    <img src="{{ image | image_url: width: 800 }}" 
                         alt="{{ prod.title }}" 
                         class="card-image {% if forloop.first %}is-active{% endif %}" 
                         data-image-index="{{ forloop.index0 }}"
                         loading="lazy"/>
                  {% endfor %}
                {% else %}
                  <img src="{{ prod.featured_image | image_url: width: 800 }}" 
                       alt="{{ prod.title }}" 
                       class="card-image is-active" 
                       data-image-index="0"
                       loading="lazy"/>
                {% endif %}
              </div>
              
              <div class="card-info-area">
                <div class="card-details-row">
                  <span class="card-title">{{ prod.title }}</span>
                  <span class="card-price">{{ prod.price | money }}</span>
                </div>
                
                {% if prod.variants.size > 1 %}
                  <div class="card-variants-wrapper" data-swiping-card-variants>
                    {% for option in prod.options_with_values %}
                      <div class="card-variant-option" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape }}">
                        <span class="card-variant-label">{{ option.name }}:</span>
                        <div class="card-variant-values">
                          {% for value in option.values %}
                            {% assign active = false %}
                            {% if value.selected %}
                              {% assign active = true %}
                            {% elsif variant.options[forloop.parentloop.index0] == value %}
                              {% assign active = true %}
                            {% endif %}
                            <button type="button" 
                                    class="card-variant-value-btn {% if active %}is-active{% endif %}" 
                                    data-value="{{ value | escape }}">
                              {{ value }}
                            </button>
                          {% endfor %}
                        </div>
                      </div>
                    {% endfor %}
                    <script type="application/json" class="card-variants-json">
                      [
                        {% for v in prod.variants %}
                          {
                            "id": {{ v.id }},
                            "title": {{ v.title | json }},
                            "available": {{ v.available | json }},
                            "price": {{ v.price | money | json }},
                            "options": {{ v.options | json }}
                          }{% unless forloop.last %},{% endunless %}
                        {% endfor %}
                      ]
                    </script>
                  </div>
                {% endif %}
              </div>
              
              <div class="swipe-badge swipe-badge-like">ADDED</div>
              <div class="swipe-badge swipe-badge-pass">PASS</div>
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="no-products-msg">No products left to swipe!</div>
      {% endfor %}
    </div>

    <div class="swipe-instruction-btn">Swipe Right to Add • Left to Pass</div>
    <button type="button" id="SwipeCartBtn" class="swipe-cart-btn">
      <span class="svg-wrapper" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center;">
        {{- 'icon-cart.svg' | inline_asset_content -}}
      </span>
      <span><a href="/cart" style="    text-decoration: none;
    color: #2b170c;"> View Cart (<span id="SwipeCartCount">{{ cart.item_count }}</span>)</a></span>
    </button>
  </div>
</div>

<style>
/* Floating Bottom-Right Action Button */
.swipe-fab-btn {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 9998;
  display: flex;
  align-items: center;
  gap: 8px;
  background: #2b170c;
  color: #e0b07a;
  border: 1px solid #CBA158;
  padding: 12px 20px;
  border-radius: 50px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.swipe-fab-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
}

/* Modal Overlay */
.swipe-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  background-image: url('{{ "collection-background.jpg" | asset_url }}') !important;
  background-size: cover !important;
  background-position: top center !important;
  background-repeat: no-repeat !important;
}

.swipe-modal.is-active {
  opacity: 1;
  pointer-events: auto;
}

.swipe-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(5px);
}

/* Modal Content Container */
.swipe-container-wrapper {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 90%;
  max-width: 420px;
  user-select: none;
  -webkit-user-select: none;
}

/* Modal Header styling */
.swipe-modal-header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 3rem 2rem;
  box-sizing: border-box;
  z-index: 12;
}

.swipe-modal-back-btn {
  background: transparent;
  border: none;
  color: #ebdccb !important;
  font-size: 1.6rem;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0;
  font-family: var(--font-body-family), sans-serif;
  opacity: 0.8;
  transition: opacity 0.2s;
}

.swipe-modal-back-btn:hover {
  opacity: 1;
}

.swipe-modal-logo {
  color: #ebdccb !important;
  font-family: Georgia, serif;
  font-size: 2.2rem;
  font-weight: 400;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  text-align: center;
}

.swipe-logo-and-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.swipe-cart-btn {
  margin-top: 15px;
  width: 100%;
  background: #CBA158;
  color: #2b170c;
  border: none;
  text-align: center;
  padding: 14px;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: background var(--duration-default) ease, transform 0.1s ease;
}

.swipe-cart-btn:hover {
  background: #dfb264;
}

.swipe-cart-btn:active {
  transform: scale(0.98);
}

.swipe-cart-btn svg {
  width: 20px;
  height: 20px;
  color: currentColor;
}

.swipe-modal-header-placeholder {
  width: 60px; /* balances the back button */
}

.swipe-cards-deck {
  position: relative;
  width: 100%;
  height: 540px;
  margin-bottom: -5rem;
}

.swipe-card {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 12px;
  cursor: grab;
  touch-action: none;
  transition: transform 0.2s ease-out;
  will-change: transform;
}

.swipe-card:active {
  cursor: grabbing;
}

.card-frame {
  position: relative;
  width: 100%;
  border-radius: 8px;
  border: 8px solid #CBA158;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  overflow: hidden;
  background: #2b170c;
  display: flex;
  flex-direction: column;
}

.swipe-card[data-dots-position="outside"] .card-frame {
  height: calc(100% - 65px);
}

.swipe-card[data-dots-position="inside"] .card-frame,
.swipe-card:not([data-dots-position]) .card-frame {
  height: 100%;
}

.card-images-container {
  position: relative;
  width: 100%;
  height: 350px;
  flex-shrink: 0;
  overflow: hidden;
  border-bottom: 2px solid rgba(203, 161, 88, 0.3);
}

.card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.card-image.is-active {
  opacity: 1;
  z-index: 1;
}

.card-info-area {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 8px;
  flex-grow: 1;
  background: #2b170c;
  z-index: 5;
  box-sizing: border-box;
}

.card-details-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(203, 161, 88, 0.2);
  padding-bottom: 4px;
}

.card-title {
  font-family: Georgia, Didot, "Playfair Display", serif;
  font-size: 1.1rem;
  font-weight: 500;
  color: #ebdccb;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 70%;
  text-align: left;
}

.card-divider {
  display: none;
}

.card-price {
  font-family: Georgia, Didot, "Playfair Display", serif;
  font-size: 1.1rem;
  font-weight: 500;
  color: #e0b07a;
}

.card-nav-dots--outside {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 65px;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
  pointer-events: none;
}

.card-nav-dots--inside {
  position: absolute;
  bottom: 15px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
  pointer-events: none;
}

.nav-dots-container {
  display: inline-flex;
  align-items: center;
  background: rgba(80, 70, 60, 0.75);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 6px 12px;
  border-radius: 20px;
  gap: 8px;
  height: 24px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

.nav-dot {
  display: block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.6);
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              background-color 0.3s ease, 
              border-radius 0.3s ease;
}

.nav-dot.is-active {
  width: 28px;
  border-radius: 4px;
  background-color: #542d13;
}

.swipe-badge {
  position: absolute;
  top: 25px;
  padding: 6px 14px;
  border-radius: 8px;
  font-weight: bold;
  font-size: 1.3rem;
  opacity: 0;
  transition: opacity 0.1s ease;
  z-index: 5;
}

.swipe-badge-like {
  left: 25px;
  border: 3px solid #2ecc71;
  color: #2ecc71;
  transform: rotate(-15deg);
}

.swipe-badge-pass {
  right: 25px;
  border: 3px solid #e74c3c;
  color: #e74c3c;
  transform: rotate(15deg);
}

.swipe-instruction-btn {
  margin-top: 30px;
  width: 100%;
  background: #2b170c;
  color: #e0b07a;
  border: 1px solid #CBA158;
  text-align: center;
  padding: 14px;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 500;
}

.no-products-msg {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #fff;
  font-size: 1.2rem;
  text-align: center;
}

/* Card Variants Container */
.card-variants-wrapper {
  position: relative;
  width: 100%;
  z-index: 6;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.card-variant-option {
  display: flex;
  align-items: center;
  gap: 8px;
}

.card-variant-label {
  font-family: var(--font-body-family), sans-serif;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #ebdccb;
  font-weight: 600;
  min-width: 45px;
  text-align: left;
}

.card-variant-values {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.card-variant-value-btn {
  background: rgba(255, 255, 255, 0.08);
  color: #ebdccb;
  border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  font-family: var(--font-body-family), sans-serif;
}

.card-variant-value-btn:hover {
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(203, 161, 88, 0.5);
  color: #fff;
}

.card-variant-value-btn.is-active {
  background: #CBA158;
  color: #2b170c;
  border-color: #CBA158;
  font-weight: 600;
}

.card-variant-value-btn.is-disabled {
  opacity: 0.3;
  text-decoration: line-through;
  pointer-events: none;
}

@keyframes shake {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  20%, 60% { transform: translate3d(-10px, 0, 0) rotate(-1deg); }
  40%, 80% { transform: translate3d(10px, 0, 0) rotate(1deg); }
}

.swipe-card.shake-anim {
  animation: shake 0.5s ease;
}
</style>

{% comment %} <script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('SwipeModal');
  const openBtn = document.getElementById('OpenSwipeDeckBtn');
  const closeBtn = document.getElementById('CloseSwipeDeckBtn');
  const backdrop = document.getElementById('SwipeModalBackdrop');
  const deck = document.getElementById('SwipeCardsDeck');
  const cards = deck.querySelectorAll('.swipe-card');

  // Toggle Modal Logic
  const openModal = () => {
    modal.classList.add('is-active');
    modal.setAttribute('aria-hidden', 'false');
  };

  const closeModal = () => {
    modal.classList.remove('is-active');
    modal.setAttribute('aria-hidden', 'true');
  };

  openBtn.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);

  // Swipe Engine
  cards.forEach(card => initSwipe(card));

  function initSwipe(card) {
    let startX = 0;
    let startY = 0;
    let currentX = 0;
    let currentY = 0;
    let isDragging = false;

    const likeBadge = card.querySelector('.swipe-badge-like');
    const passBadge = card.querySelector('.swipe-badge-pass');

    const onStart = (e) => {
      isDragging = true;
      startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      startY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;
      card.style.transition = 'none';
    };

    const onMove = (e) => {
      if (!isDragging) return;

      const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;

      currentX = clientX - startX;
      currentY = clientY - startY;

      const rotate = currentX * 0.08;
      card.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) rotate(${rotate}deg)`;

      if (currentX > 40) {
        likeBadge.style.opacity = Math.min(currentX / 100, 1);
        passBadge.style.opacity = 0;
      } else if (currentX < -40) {
        passBadge.style.opacity = Math.min(Math.abs(currentX) / 100, 1);
        likeBadge.style.opacity = 0;
      } else {
        likeBadge.style.opacity = 0;
        passBadge.style.opacity = 0;
      }
    };

    const onEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      card.style.transition = 'transform 0.4s ease, opacity 0.4s ease';

      const threshold = 100;

      if (currentX > threshold) {
        card.style.transform = `translate3d(${window.innerWidth}px, ${currentY}px, 0) rotate(45deg)`;
        card.style.opacity = '0';
        addToCart(card.dataset.variantId);
        setTimeout(() => card.remove(), 400);
      } else if (currentX < -threshold) {
        card.style.transform = `translate3d(-${window.innerWidth}px, ${currentY}px, 0) rotate(-45deg)`;
        card.style.opacity = '0';
        setTimeout(() => card.remove(), 400);
      } else {
        card.style.transform = 'translate3d(0, 0, 0) rotate(0deg)';
        likeBadge.style.opacity = 0;
        passBadge.style.opacity = 0;
      }
    };

    card.addEventListener('touchstart', onStart, { passive: true });
    card.addEventListener('touchmove', onMove, { passive: true });
    card.addEventListener('touchend', onEnd);

    card.addEventListener('mousedown', onStart);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onEnd);
  }

  // Ajax Add to Cart
  function addToCart(variantId) {
    const formData = {
      items: [{
        id: parseInt(variantId, 10),
        quantity: 1
      }]
    };

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(() => {
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      document.dispatchEvent(new CustomEvent('cart:updated'));
    })
    .catch((error) => console.error('Error adding to cart:', error));
  }
});
</script> {% endcomment %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('SwipeModal');
  const closeBtn = document.getElementById('CloseSwipeDeckBtn');
  const backdrop = document.getElementById('SwipeModalBackdrop');
  const deck = document.getElementById('SwipeCardsDeck');
  const cards = deck ? deck.querySelectorAll('.swipe-card') : [];
  
  // Select all layout toggles (both page elements and modal elements)
  const layoutToggles = document.querySelectorAll('#layoutToggleCheckbox, .layout-toggle-checkbox');

  // Swipe Cart count initialization and updater
  const swipeCartCount = document.getElementById('SwipeCartCount');
  function updateSwipeCartCount() {
    fetch(window.Shopify.routes.root + 'cart.js')
      .then(res => res.json())
      .then(cart => {
        if (swipeCartCount) {
          swipeCartCount.textContent = cart.item_count;
        }
      })
      .catch(err => console.error('Error fetching cart:', err));
  }
  updateSwipeCartCount();

  // Wire up the SwipeCartBtn click listener
  const cartBtn = document.getElementById('SwipeCartBtn');
  if (cartBtn) {
    cartBtn.addEventListener('click', () => {
      const cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer && typeof cartDrawer.open === 'function') {
        cartDrawer.open();
      } else {
        const cartIconBtn = document.querySelector('#cart-icon-bubble, .header__icon--cart, [data-cart-drawer-toggle], .js-drawer-open-right');
        if (cartIconBtn) {
          cartIconBtn.click();
        }
      }
    });
  }

  // Toggle Modal Logic
  const openModal = () => {
    if (modal) {
      modal.classList.add('is-active');
      modal.setAttribute('aria-hidden', 'false');
    }
    layoutToggles.forEach(toggle => {
      toggle.checked = true;
    });
  };

  const closeModal = () => {
    if (modal) {
      modal.classList.remove('is-active');
      modal.setAttribute('aria-hidden', 'true');
    }
    layoutToggles.forEach(toggle => {
      toggle.checked = false;
    });
  };

  layoutToggles.forEach(toggle => {
    toggle.checked = false;
    toggle.addEventListener('change', () => {
      if (toggle.checked) {
        openModal();
      } else {
        closeModal();
      }
    });
  });

  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      closeModal();
      window.location.reload();
    });
  }
  if (backdrop) backdrop.addEventListener('click', closeModal);

  // Swipe Engine
  cards.forEach(card => initSwipe(card));

  function updateSelectedVariant(card) {
    const variantsWrapper = card.querySelector('[data-swiping-card-variants]');
    if (!variantsWrapper) return;
    
    // Gather selected values
    const selectedOptions = [];
    const optionEls = variantsWrapper.querySelectorAll('.card-variant-option');
    optionEls.forEach(optionEl => {
      const activeBtn = optionEl.querySelector('.card-variant-value-btn.is-active');
      if (activeBtn) {
        selectedOptions.push(activeBtn.getAttribute('data-value'));
      } else {
        selectedOptions.push(null);
      }
    });
    
    // Parse variants JSON
    const jsonEl = variantsWrapper.querySelector('.card-variants-json');
    if (!jsonEl) return;
    try {
      const variants = JSON.parse(jsonEl.textContent);
      
      // Find matching variant
      const matchedVariant = variants.find(variant => {
        return variant.options.every((optValue, idx) => {
          return selectedOptions[idx] === optValue;
        });
      });
      
      if (matchedVariant) {
        // Update variant id
        card.setAttribute('data-variant-id', matchedVariant.id);
        
        // Update price
        const priceEl = card.querySelector('.card-price');
        if (priceEl) {
          priceEl.textContent = matchedVariant.price;
        }
        
        // Update availability
        const likeBadge = card.querySelector('.swipe-badge-like');
        if (matchedVariant.available) {
          card.classList.remove('is-sold-out');
          if (likeBadge) {
            likeBadge.textContent = 'ADDED';
            likeBadge.style.borderColor = '#2ecc71';
            likeBadge.style.color = '#2ecc71';
          }
        } else {
          card.classList.add('is-sold-out');
          if (likeBadge) {
            likeBadge.textContent = 'SOLD OUT';
            likeBadge.style.borderColor = '#e74c3c';
            likeBadge.style.color = '#e74c3c';
          }
        }
      }
    } catch (e) {
      console.error('Error parsing variants JSON:', e);
    }
  }

  function initSwipe(card) {
    let startX = 0;
    let startY = 0;
    let currentX = 0;
    let currentY = 0;
    let isDragging = false;
    let startTime = 0;

    const likeBadge = card.querySelector('.swipe-badge-like');
    const passBadge = card.querySelector('.swipe-badge-pass');

    // Initialize variant click event handling and event propagation stopping
    const variantsWrapper = card.querySelector('[data-swiping-card-variants]');
    if (variantsWrapper) {
      const stopDrag = (e) => {
        e.stopPropagation();
      };
      
      variantsWrapper.addEventListener('touchstart', stopDrag, { passive: true });
      variantsWrapper.addEventListener('touchmove', stopDrag, { passive: true });
      variantsWrapper.addEventListener('touchend', stopDrag);
      variantsWrapper.addEventListener('mousedown', stopDrag);
      variantsWrapper.addEventListener('mouseup', stopDrag);
      variantsWrapper.addEventListener('click', stopDrag);
      
      const buttons = variantsWrapper.querySelectorAll('.card-variant-value-btn');
      buttons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          
          const parent = btn.closest('.card-variant-values');
          parent.querySelectorAll('.card-variant-value-btn').forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          
          updateSelectedVariant(card);
        });
      });
    }

    const handleCardTap = (clientX) => {
      const cardRect = card.getBoundingClientRect();
      const tapX = clientX - cardRect.left;
      const isLeft = tapX < cardRect.width / 2;

      const images = card.querySelectorAll('.card-image');
      if (images.length <= 1) return;

      let activeIndex = 0;
      images.forEach((img, index) => {
        if (img.classList.contains('is-active')) {
          activeIndex = index;
        }
      });

      let newIndex = activeIndex;
      if (isLeft) {
        newIndex = (activeIndex - 1 + images.length) % images.length;
      } else {
        newIndex = (activeIndex + 1) % images.length;
      }

      images[activeIndex].classList.remove('is-active');
      images[newIndex].classList.add('is-active');

      const dots = card.querySelectorAll('.nav-dot');
      if (dots.length > 0) {
        dots.forEach((dot, index) => {
          if (index === newIndex) {
            dot.classList.add('is-active');
          } else {
            dot.classList.remove('is-active');
          }
        });
      }
    };

    const onStart = (e) => {
      isDragging = true;
      const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;
      startX = clientX;
      startY = clientY;
      currentX = 0;
      currentY = 0;
      startTime = Date.now();
      card.style.transition = 'none';
    };

    const onMove = (e) => {
      if (!isDragging) return;

      const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;

      currentX = clientX - startX;
      currentY = clientY - startY;

      const rotate = currentX * 0.08;
      card.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) rotate(${rotate}deg)`;

      if (currentX > 40) {
        likeBadge.style.opacity = Math.min(currentX / 100, 1);
        passBadge.style.opacity = 0;
      } else if (currentX < -40) {
        passBadge.style.opacity = Math.min(Math.abs(currentX) / 100, 1);
        likeBadge.style.opacity = 0;
      } else {
        likeBadge.style.opacity = 0;
        passBadge.style.opacity = 0;
      }
    };

    const onEnd = (e) => {
      if (!isDragging) return;
      isDragging = false;
      card.style.transition = 'transform 0.4s ease, opacity 0.4s ease';

      const endTime = Date.now();
      const duration = endTime - startTime;
      const moveThreshold = 10;
      const clickDuration = 250;

      const absX = Math.abs(currentX);
      const absY = Math.abs(currentY);

      if (absX < moveThreshold && absY < moveThreshold && duration < clickDuration) {
        handleCardTap(startX);
        return;
      }

      const threshold = 100;

      if (currentX > threshold) {
        // SWIPE RIGHT: Add to Cart
        if (card.classList.contains('is-sold-out')) {
          card.style.transform = 'translate3d(0, 0, 0) rotate(0deg)';
          likeBadge.style.opacity = 0;
          passBadge.style.opacity = 0;
          card.classList.add('shake-anim');
          setTimeout(() => card.classList.remove('shake-anim'), 500);
          return;
        }
        card.style.transform = `translate3d(${window.innerWidth}px, ${currentY}px, 0) rotate(45deg)`;
        card.style.opacity = '0';
        addToCart(card.dataset.variantId);
        setTimeout(() => card.remove(), 400);
      } else if (currentX < -threshold) {
        // SWIPE LEFT: Pass / Remove
        card.style.transform = `translate3d(-${window.innerWidth}px, ${currentY}px, 0) rotate(-45deg)`;
        card.style.opacity = '0';
        setTimeout(() => card.remove(), 400);
      } else {
        card.style.transform = 'translate3d(0, 0, 0) rotate(0deg)';
        likeBadge.style.opacity = 0;
        passBadge.style.opacity = 0;
      }
    };

    card.addEventListener('touchstart', onStart, { passive: true });
    card.addEventListener('touchmove', onMove, { passive: true });
    card.addEventListener('touchend', onEnd);

    card.addEventListener('mousedown', onStart);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onEnd);
  }

  // Universal Shopify AJAX Add to Cart
  function addToCart(variantId) {
    const cartDrawer = document.querySelector('cart-drawer');
    const cartNotification = document.querySelector('cart-notification');

    // Build array of section IDs to request from Shopify API
    const sectionsToFetch = [];
    if (cartDrawer) sectionsToFetch.push('cart-drawer', 'cart-icon-bubble');
    if (cartNotification) sectionsToFetch.push('cart-notification', 'cart-icon-bubble');

    const formData = {
      items: [{
        id: parseInt(variantId, 10),
        quantity: 1
      }],
      sections: sectionsToFetch // FIXED: Must be an Array
    };

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/javascript'
      },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      // 1. Dawn & OS 2.0 Web Components (Drawer / Notification)
      if (cartDrawer && data.sections && data.sections['cart-drawer']) {
        cartDrawer.renderContents(data);
      } else if (cartNotification && data.sections && data.sections['cart-notification']) {
        cartNotification.renderContents(data);
      } else if (cartDrawer) {
        // Fallback: Fetch cart-drawer HTML directly if section parsing was skipped
        fetch(window.Shopify.routes.root + '?section_id=cart-drawer')
          .then(res => res.text())
          .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newContent = doc.querySelector('.drawer__inner') || doc.querySelector('#CartDrawer');
            const currentContent = cartDrawer.querySelector('.drawer__inner') || cartDrawer.querySelector('#CartDrawer');
            if (newContent && currentContent) {
              currentContent.innerHTML = newContent.innerHTML;
            }
          });
      }

      // 2. Trigger Shopify PubSub Event (Dawn Standard)
      if (typeof publish === 'function' && window.PUB_SUB_EVENTS) {
        publish(PUB_SUB_EVENTS.cartUpdate, { source: 'swipe-card', cart: data });
      }

      // 3. Custom Theme Dispatchers
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: data } }));
      document.dispatchEvent(new CustomEvent('cart:build', { detail: data }));
      document.dispatchEvent(new CustomEvent('theme:cart:change', { detail: { cart: data } }));

      // 4. Open Cart Drawer
      if (cartDrawer && typeof cartDrawer.open === 'function') {
        cartDrawer.open();
      } else {
        const cartIconBtn = document.querySelector('#cart-icon-bubble, .header__icon--cart, [data-cart-drawer-toggle], .js-drawer-open-right');
        if (cartIconBtn && !cartDrawer?.classList.contains('active')) {
          cartIconBtn.click();
        }
      }

      // Update our swipe cart count
      updateSwipeCartCount();
    })
    .catch((error) => console.error('Error adding product to cart:', error));
  }
});
</script>


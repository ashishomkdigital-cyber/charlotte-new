<style>
/* Return Policy Modal */
.icon-with-text__item:nth-of-type(2) {
  cursor: pointer;
}

.return-policy-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 99999;
}

.return-policy-modal.active {
  display: block;
}

.return-policy-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
}

.return-policy-content {
  position: absolute;
  top: 50%;
  left: 50%;
  width: calc(100% - 40px);
  max-width: 480px;
  max-height: 90vh;
  overflow-y: auto;
  padding: 30px;
  background: #ebdccb;
  color: #3b3023;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  transform: translate(-50%, -50%) scale(0.95);
  opacity: 0;
  transition: all 0.25s ease;
  box-sizing: border-box;
}

.return-policy-modal.active .return-policy-content {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
}

.return-policy-content h3 {
  margin: 0 0 14px;
  font-family: var(--font-serif), serif;
  font-size: 24px;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: #3b3023;
}

.return-policy-text {
  font-size: 14px;
  line-height: 1.6;
  color: rgba(59, 48, 35, 0.9);
  margin-bottom: 20px;
}

.return-policy-text p {
  margin: 0 0 10px;
}

.return-policy-close {
  position: absolute;
  top: 14px;
  right: 18px;
  border: 0;
  background: transparent;
  font-size: 28px;
  line-height: 1;
  color: #3b3023;
  cursor: pointer;
  transition: opacity 0.2s;
}

.return-policy-close:hover {
  opacity: 0.7;
}

/* Return Request Form Styles */
.easy-return-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
  text-align: left;
}

.easy-return-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.easy-return-field label {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #3b3023;
}

.easy-return-field label .required {
  color: #b56549;
}

.easy-return-field input,
.easy-return-field textarea {
  width: 100%;
  padding: 12px 14px;
  font-size: 14px;
  font-family: inherit;
  color: #3b3023;
  background: #ffffff;
  border: 1px solid rgba(59, 48, 35, 0.25);
  border-radius: 6px;
  box-sizing: border-box;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  outline: none;
}

.easy-return-field input:focus,
.easy-return-field textarea:focus {
  border-color: #3b3023;
  box-shadow: 0 0 0 2px rgba(59, 48, 35, 0.15);
}

.easy-return-submit-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 14px 20px;
  margin-top: 6px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ffffff;
  background-color: #4C220299 !important;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 0.25s ease, transform 0.15s ease;
}

.easy-return-submit-btn:hover {
  background-color: #4C2202 !important;
  transform: translateY(-1px);
}

.easy-return-submit-btn:active {
  transform: translateY(0);
}

.easy-return-submit-btn svg {
  fill: #ffffff;
  flex-shrink: 0;
}
</style>

<div id="return-policy-modal" class="return-policy-modal">
  <div class="return-policy-overlay"></div>

  <div class="return-policy-content">
    <button class="return-policy-close" type="button" aria-label="Close modal">&times;</button>

    <h3>Easy Return Request</h3>

    <div class="return-policy-text">
      <p>
        We accept returns within 7 days of delivery for unused products in original packaging. Please fill out your details below to submit a return request via WhatsApp.
      </p>
    </div>

    <form id="easy-return-form" class="easy-return-form">
      {% if product %}
        <input type="hidden" name="product_title" value="{{ product.title | escape }}">
      {% endif %}

      <div class="easy-return-field">
        <label for="return-name">Name <span class="required">*</span></label>
        <input type="text" id="return-name" name="name" placeholder="Enter your full name" required>
      </div>

      <div class="easy-return-field">
        <label for="return-email">Email <span class="required">*</span></label>
        <input type="email" id="return-email" name="email" placeholder="Enter your email address" required>
      </div>

      <div class="easy-return-field">
        <label for="return-address">Address <span class="required">*</span></label>
        <textarea id="return-address" name="address" rows="3" placeholder="Enter your delivery address" required></textarea>
      </div>

      <button type="submit" class="easy-return-submit-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.002 3.659 3.745-.982z"/>
        </svg>
        Submit Request on WhatsApp
      </button>
    </form>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const modal = document.querySelector('#return-policy-modal');
  const overlay = document.querySelector('.return-policy-overlay');
  const closeButton = document.querySelector('.return-policy-close');
  const returnForm = document.querySelector('#easy-return-form');

  if (!modal) return;

  function openModal() {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Attach triggers
  const returnButton = document.querySelector('.icon-with-text__item:nth-of-type(2)');
  if (returnButton) {
    returnButton.addEventListener('click', function (e) {
      e.preventDefault();
      openModal();
    });
  }

  document.querySelectorAll('.icon-with-text__item').forEach(function(item) {
    if (item.textContent && item.textContent.toLowerCase().includes('easy return')) {
      item.style.cursor = 'pointer';
      item.addEventListener('click', function(e) {
        e.preventDefault();
        openModal();
      });
    }
  });

  if (closeButton) closeButton.addEventListener('click', closeModal);
  if (overlay) overlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      closeModal();
    }
  });

  // Handle Form Submission -> Redirect to WhatsApp (wa.me/9876543210)
  if (returnForm) {
    returnForm.addEventListener('submit', function (e) {
      e.preventDefault();

      const name = document.querySelector('#return-name').value.trim();
      const email = document.querySelector('#return-email').value.trim();
      const address = document.querySelector('#return-address').value.trim();
      const productInput = returnForm.querySelector('input[name="product_title"]');
      const productTitle = productInput ? productInput.value : '';

      let message = `Hello, I would like to request an Easy Return.\n\n`;
      message += `*Name:* ${name}\n`;
      message += `*Email:* ${email}\n`;
      message += `*Address:* ${address}\n`;
      if (productTitle) {
        message += `*Product:* ${productTitle}\n`;
      }
      message += `*Page:* ${window.location.href}`;

      const whatsappNumber = '9876543210';
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

      window.open(whatsappUrl, '_blank');
      closeModal();
      returnForm.reset();
    });
  }
});
</script>
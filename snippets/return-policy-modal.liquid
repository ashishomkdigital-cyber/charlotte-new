<style>
    /* Return Policy Modal */

    .icon-with-text__item:nth-of-type(2){cursor:pointer;}
.return-policy-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 99999;
}

.return-policy-modal.active {
  display: block;
}

.return-policy-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(3px);
}

.return-policy-content {
  position: absolute;
  top: 50%;
  left: 50%;
  width: calc(100% - 40px);
  max-width: 480px;
  max-height: 80vh;
  overflow-y: auto;
  padding: 30px;
  background: #ebdccb;
  border-radius: 12px;
  transform: translate(-50%, -50%) scale(0.95);
  opacity: 0;
  transition: 0.25s ease;
}

.return-policy-modal.active .return-policy-content {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
}

.return-policy-content h3 {
  margin: 0 0 18px;
  font-size: 22px;
}

.return-policy-text {
  font-size: 14px;
  line-height: 1.7;
}

.return-policy-text p {
  margin: 0 0 12px;
}

.return-policy-close {
  position: absolute;
  top: 10px;
  right: 14px;
  border: 0;
  background: transparent;
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
}
</style>
<div id="return-policy-modal" class="return-policy-modal">
  <div class="return-policy-overlay"></div>

  <div class="return-policy-content">
    <button class="return-policy-close" type="button">&times;</button>

    <h3>Return Policy</h3>

    <div class="return-policy-text">
      <p>
        We accept returns within 7 days of delivery, provided the product
        is unused, unworn, and in its original packaging.
      </p>

      <p>
        Products that are customized, altered, or marked as non-returnable
        are not eligible for return.
      </p>

      <p>
        For any return-related queries, please contact our support team.
      </p>
    </div>
  </div>
</div>


<script>
document.addEventListener('DOMContentLoaded', function () {

  const returnButton = document.querySelector('.icon-with-text__item:nth-of-type(2)');
  const modal = document.querySelector('#return-policy-modal');
  const overlay = document.querySelector('.return-policy-overlay');
  const closeButton = document.querySelector('.return-policy-close');

  if (!returnButton || !modal) return;

  returnButton.addEventListener('click', function (e) {
    e.preventDefault();
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  function closeModal() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  closeButton.addEventListener('click', closeModal);
  overlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      closeModal();
    }
  });

});
</script>
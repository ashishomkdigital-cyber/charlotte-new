<div id="return-policy-modal" class="return-policy-modal">
  <div class="return-policy-overlay"></div>

  <div class="return-policy-content">
    <button class="return-policy-close" type="button">&times;</button>

    <h3>Return Policy</h3>

    <div class="return-policy-text">
      <p>
        We accept returns within 7 days of delivery, provided the product
        is unused, unworn, and in its original packaging.
      </p>

      <p>
        Products that are customized, altered, or marked as non-returnable
        are not eligible for return.
      </p>

      <p>
        For any return-related queries, please contact our support team.
      </p>
    </div>
  </div>
</div>